# ── Host / network ────────────────────────────────────────────────────
# The server's LAN address. Used for every published port, gluetun's LAN
# allow-list, and by scripts/*.py. Find it with:  ip -4 addr show
LAN_IP=192.168.1.10
# The LAN subnet, so gluetun lets your browser reach the web UIs.
LAN_SUBNET=192.168.1.0/24
# Your router, used as upstream DNS by the bridge containers.
LAN_DNS=192.168.1.1

# ── Host / permissions ────────────────────────────────────────────────
PUID=1000
PGID=1000
TZ=Europe/London

# ── AirVPN (WireGuard) ────────────────────────────────────────────────
# Generate a device in the AirVPN Client Area -> Config Generator:
#   Protocol: WireGuard  |  Device: <name>  |  Server or Country
# Download the .conf, then copy the values across:
#
#   [Interface]
#   PrivateKey = ...   -> WIREGUARD_PRIVATE_KEY
#   Address    = ...   -> WIREGUARD_ADDRESSES
#   [Peer]
#   PresharedKey = ... -> WIREGUARD_PRESHARED_KEY
#
# WIREGUARD_ADDRESSES: keep only the IPv4 (e.g. 10.128.x.x/32).
# This host has no container IPv6 — leaving the fd7d:... address in will
# make gluetun fail to bring the interface up.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=

# Exit country. AirVPN names: Netherlands, Switzerland, Sweden, Germany,
# United Kingdom, Canada, ...  Leave blank for any server.
SERVER_COUNTRIES=Canada

# ── Port forwarding ───────────────────────────────────────────────────
# AirVPN Client Area -> Ports -> add a port. AirVPN gives you a fixed port
# number; set it here. It is used for BOTH the gluetun tunnel firewall rule
# and qbittorrent's listening port, so incoming peer connections work.
# Without it torrents still download but you stay unconnectable (slower).
VPN_FORWARDED_PORT=

# ── Plex ──────────────────────────────────────────────────────────────
# One-time server claim token from https://plex.tv/claim (valid 4 minutes).
# Get it immediately before the first `docker compose up`. Blank it after
# the server is claimed.
PLEX_CLAIM=

# ── Unpackerr -> *arr API keys ────────────────────────────────────────
# Fill in AFTER first boot: each app's Settings -> General -> API Key.
# Then: docker compose up -d unpackerr
RADARR_API_KEY=
SONARR_API_KEY=
LIDARR_API_KEY=
